  <script>

    function getRegisterUri() {
      // Get the current URL from the browser
      const currentUrl = window.location.href;

      // Create a URL object
      const parsedUrl = new URL(currentUrl);

      // Use URLSearchParams to parse the query string
      const queryParams = new URLSearchParams(parsedUrl.search);

      // Get the value of register_uri or return an empty string if it's not present
      return queryParams.get('register_uri') ? decodeURIComponent(queryParams.get('register_uri')) : '';
    }

    function getForgotUserNameUri() {
      // Get the current URL from the browser
      const currentUrl = window.location.href;

      // Create a URL object
      const parsedUrl = new URL(currentUrl);

      // Use URLSearchParams to parse the query string
      const queryParams = new URLSearchParams(parsedUrl.search);

      // Get the value of register_uri or return an empty string if it's not present
      return queryParams.get('forgotusername_uri') ? decodeURIComponent(queryParams.get('forgotusername_uri')) : '';
    }

    $(function() {
      $('#localAccountForm').insertAfter('.heading');
      $('.divider').insertAfter('#localAccountForm');
      $('.divider').find('h2').text("Or sign in with")
      $('button').addClass('btn');

      $('#forgotPassword').appendTo("#accountHelpers").addClass('text-right pull-right d-block').text('Forgot password?');

      $('#accountHelpers').insertBefore('.entry-item + .working');

      $('#agreementHolder').insertBefore('#localAccountForm + .divider');

      var input_border = '<span class="input_border"/>';

      $('.entry-item input').each(function(i, e){
        $(input_border).insertAfter(e);
      });

      const registerUri = getRegisterUri();
      const forgotUserNameUri = getForgotUserNameUri();

      if(!registerUri) {
        $('#accountRegisterHolder').addClass('d-none');
      } else {
        $('#registerForAccount').attr('href', registerUri);
      }

      if(!forgotUserNameUri) {
        $('#forgotUsername').removeClass('d-block').addClass('d-none');
      } else {
        $('#forgotUsername').attr('href', forgotUserNameUri);
      }

      $('.password-label > label').addClass('clearfix w-100').append('<button id="show-password" type="button" class="btn btn-link password-hidden pull-right p-0"><span id="password-hidden">Show <i class="fa fa-eye"></i></span><span id="password-shown">Hide <i class="fa fa-eye-slash"></i></span></button>')

      $(document).on('click', '#show-password', function(){
        if($(this).hasClass('password-hidden')){
          $('#password').attr('type', 'text');
        } else {
          $('#password').attr('type', 'password');
        }

        $(this).toggleClass('password-hidden password-shown');
      });

      $('#FacebookExchange').text('Facebook').prepend('<img src="https://mlslpub.blob.core.windows.net/social-sign-in/sign-in-policies/development/images/facebook-logo-color.svg" />');
      $('#GoogleExchange').text('Google').prepend('<img src="https://mlslpub.blob.core.windows.net/social-sign-in/sign-in-policies/development/images/google-icon.svg" />');

  });

    // Select the target node (the <p> element inside the div)
    const targetNode = document.querySelector('.error.pageLevel p');

    // Create a MutationObserver instance
    const observer = new MutationObserver((mutationsList) => {
      for (let mutation of mutationsList) {
        if (mutation.type === 'childList' && targetNode.textContent.includes("We can't seem to find your account")) {
          // Create the initial part of the message
          const initialText = document.createTextNode('We can’t find your account in the system. You may ');

          // Create and style the bold 'not' text
          const boldText = document.createElement('strong');
          boldText.textContent = 'not ';

          // Continue the message after 'not'
          const continuationText = document.createTextNode('have created an MLSListings account yet. ');

          // Create the 'Create an Account' link
          const registerLink = document.createElement('a');
          registerLink.href = document.getElementById('registerForAccount').href;
          registerLink.textContent = 'Create an Account';

          // Add ' now.' after the link
          const finalText = document.createTextNode(' now.');

          // Clear the existing content and append the new nodes
          targetNode.textContent = '';
          targetNode.append(initialText, boldText, continuationText, registerLink, finalText);
        }

        if (mutation.type === 'childList' && targetNode.textContent.includes("The password has expired.")) {
					console.log(targetNode.textContent);
          // Create the initial part of the message
          const initialText = document.createTextNode('Your password has expired. Please click ');

          // Create the 'Reset Password' link
          const resetLink = document.createElement('a');
          resetLink.href = document.getElementById('forgotPassword').href;
          resetLink.textContent = 'Reset Password';

          // Continue the message after 'not'
          const continuationText = document.createTextNode(' to continue.');

          // Clear the existing content and append the new nodes
          targetNode.textContent = '';
          targetNode.append(initialText, resetLink, continuationText);
        }

      }
    });


    // Set up the observer configuration to watch for changes in child nodes
    const config = { childList: true };

    // Start observing the target node
    observer.observe(targetNode, config);
  </script>

