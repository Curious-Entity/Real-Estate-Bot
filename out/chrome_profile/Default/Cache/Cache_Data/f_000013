<script type="text/javascript">
	$(function () {
		$('#m_spnNotifications').tooltip();
		$('#m_spnLogOutAs').tooltip();
		$('#ctl02_ctl06_m_btnFontSize').tooltip();

        const uiVersionSwitchForm = $('#mtrxUIVersionSwitchConfirmForm');
		
		uiVersionSwitchForm.on('click', 'button[type=submit]', (e) => {
			e.stopPropagation();
			e.preventDefault();

			const action = uiVersionSwitchForm.data('action-url');

			const body = new FormData();
			body.append('__RequestVerificationToken', uiVersionSwitchForm.find('input[name=__RequestVerificationToken]').val());
			body.append('uiVersion', uiVersionSwitchForm.find('input[name=uiVersion]').val());

			uiVersionSwitchForm.find('button[type=submit]')
				.attr({ disabled: true })
				.addClass('disabled');

			fetch(action, {
				method: 'POST',
				body,
			}).then((response) => {
				if(response.redirected){
					window.location = response.url;
				}else {
					alert('An error occurred');
				}
			}).finally(() => {
				uiVersionSwitchForm.find('button[type=submit]')
					.removeAttr('disabled')
					.removeClass('disabled');
			});
		});

		$('#mtrxUIVersionSwitchConfirm').on('hide.bs.modal', () => {
			document.getElementById('ctl02_ctl06_m_uiVersionSwitch').checked = true;
		});
	});
</script>

