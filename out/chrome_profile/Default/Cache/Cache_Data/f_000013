<script>
	function UIVersionSwitchPost()
	{
		var dataToSend = {
			uiVersion: $('#mtrxUIVersionInput').val(),
			__RequestVerificationToken: $("[name='__RequestVerificationToken']").val()
		};

		$.ajax({
			url: '/Matrix/home/ChangeUIVersion',
			type: 'POST',
			data: dataToSend,
			success: (function (result)
			{
				if (result.hasOwnProperty('target')) {
					window.location.href = result.target;
				}
				else if (result.hasOwnProperty('errorMessage')) {
					alert(result.errorMessage);
				}
				else {
					alert('UnExpected - ' + result);
				}
			})
		});
	}
